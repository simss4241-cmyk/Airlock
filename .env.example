# Copy this file to .env and fill in the values. .env is gitignored — it must
# never be committed, and it must never be read by anything in public/.
#
# The browser talks to Airlock's own /api/chat; only server.js talks to Nebius.

# Nebius Token Factory — https://tokenfactory.nebius.com  (Settings -> API keys)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Remote tiers. Serverless ("Public") models only — Dedicated bills by the hour.
AIRLOCK_MODEL_CLASSIFIER=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
AIRLOCK_MODEL_VERDICT=nvidia/nemotron-3-super-120b-a12b
AIRLOCK_MODEL_DEEP=nvidia/Nemotron-3-Ultra-550b-a55b

# Tavily (optional, for the research committee member)
TAVILY_API_KEY=

# ── Hosting ──────────────────────────────────────────────────────────────────
# Both are UNSET for local use, which is correct: requiring a login to read your
# own notes on your own machine would be absurd. Set both before hosting.

# Any /api request must present this, as an X-Airlock-Token header or an
# airlock_token cookie. A shared secret, not identity: everyone holding it sees
# the same data. Fine for a demo, NOT per-user isolation.
AIRLOCK_TOKEN=

# Remote calls allowed per process, since each one spends real credits. A
# restart resets the count. Unset means uncapped.
AIRLOCK_REMOTE_BUDGET=

# Shows a permanent, non-dismissible banner saying this instance is shared and
# anything typed here is visible to other visitors. Set it on any instance more
# than one person can reach.
AIRLOCK_DEMO=
