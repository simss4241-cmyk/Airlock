# Copy this file to .env and fill in the values. .env is gitignored — it must
# never be committed, and it must never be read by anything in public/.
#
# The browser talks to Airlock's own /api/chat; only server.js talks to Nebius.

# Nebius Token Factory — https://tokenfactory.nebius.com  (Settings -> API keys)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Remote tiers. Serverless ("Public") models only — Dedicated bills by the hour.
AIRLOCK_MODEL_CLASSIFIER=nvidia/nemotron-3-nano-30b-a3b
AIRLOCK_MODEL_VERDICT=nvidia/nemotron-3-super-120b-a12b
AIRLOCK_MODEL_DEEP=nvidia/nemotron-3-ultra-550b-a55b

# Tavily (optional, for the research committee member)
TAVILY_API_KEY=
