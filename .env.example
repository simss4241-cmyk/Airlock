# Copy this file to .env and fill in the values. .env is gitignored — it must
# never be committed, and it must never be read by anything in public/.
#
# The browser talks only to Airlock's own server; only the server talks to Nebius or Tavily.

# Nebius Token Factory — https://tokenfactory.nebius.com  (Settings -> API keys)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Web search for a duet side's 🌐 switch (https://tavily.com). Optional: without it a side
# can still open links you give it. Every query is ruled on by the local gate before it
# leaves, and recorded as a crossing.
TAVILY_API_KEY=

# Remote tiers. Serverless ("Public") models only — Dedicated bills by the hour.
AIRLOCK_MODEL_CLASSIFIER=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
AIRLOCK_MODEL_VERDICT=nvidia/nemotron-3-super-120b-a12b
AIRLOCK_MODEL_DEEP=nvidia/Nemotron-3-Ultra-550b-a55b

# Which model the app opens on when no config has been saved yet. Defaults to
# AIRLOCK_MODEL_VERDICT when a key is present. Without one it opens on a local model
# chosen to RUN here: this one if it is installed, else nemotron-3-nano:4b, else the
# largest model at or under 8 GB, else the smallest there is — never simply the
# largest, which on an ordinary card is the one that crashes. Airlock does NOT
# require you to download anything.
AIRLOCK_MODEL_DEFAULT=

# Which LOCAL model rules on whether anything may cross the boundary. It must be
# local — a remote gate would have to receive the content in order to judge whether
# the content may be sent, which is the one thing the gate exists to prevent, so a
# remote id here is ignored.
#
# Recommended: qwen2.5:14b  (ollama pull qwen2.5:14b — 9 GB, ~0.7 s a ruling)
#
# Measured with tools/gate_bench.js: it has released no secret on any test set. On a
# smaller card, nemotron-3-nano:4b (2.8 GB, ~0.3 s) fits easily but released about a
# third of what it should have withheld; the credential scanner in front of the gate
# catches known formats either way. See docs/verification.md for the numbers.
#
# Unset, or named but not installed, Airlock picks the default model if it is local,
# else the smallest installed model over a floor, because a gate that stalls fails
# closed and reaches you as a refusal of a harmless message. That is a choice about
# fitting, not about quality — name one here and quality becomes yours to choose.
AIRLOCK_GATE_MODEL=qwen2.5:14b

# Narrows the remote dropdown to comma-separated substrings, e.g. "nvidia/" for a
# curated demo. Unset lists everything Token Factory serves.
AIRLOCK_REMOTE_ALLOW=

# Config file location. Defaults to airlock-config.json beside server.js; set it
# to keep runtime config outside the code directory on a host.
AIRLOCK_CONFIG=

# ── Hosting ──────────────────────────────────────────────────────────────────
# All UNSET for local use, which is correct: requiring a login to read your own
# notes on your own machine would be absurd. Set them before hosting.

# Any /api request must present this, as an X-Airlock-Token header or an
# airlock_token cookie. A shared secret, not identity: everyone holding it sees
# the same data. Fine for a demo, NOT per-user isolation.
AIRLOCK_TOKEN=

# Remote calls allowed, since each one spends real credits. Unset means uncapped.
#   On a desk, or hosted without sandboxes: per PROCESS — a restart resets the count.
#   With AIRLOCK_SANDBOXES=1: per UTC DAY for the whole demo, kept in the sandbox index,
#   so a restart or a crash loop does not refill it.
AIRLOCK_REMOTE_BUDGET=
# With sandboxes: how many remote calls ONE visitor may make (default 40), so a single
# visitor cannot spend the whole day's allowance. Kept in their own sandbox.
AIRLOCK_SANDBOX_REMOTE_BUDGET=
# With sandboxes: how many generations one visitor may have in flight at once (default
# 2). The GPU and the generation queue are shared by every visitor.
AIRLOCK_SANDBOX_CONCURRENT=

# One private sandbox per visitor: a random id in an HttpOnly cookie, and a database of
# their own, seeded like a fresh install. No login and no personal data — a judge clicks
# the link and has a desk nobody else can see. UNSET on a desk. Set to 1 for a public demo.
# A lost cookie is a lost sandbox; there is no account to recover it through.
AIRLOCK_SANDBOXES=
# Where sandboxes live (default ./sandboxes, gitignored), how long one survives idle
# (default 168 h, so a judge who returns after the deadline still finds their work), how
# many may exist at once (500), and how many one address may make per hour (20).
AIRLOCK_SANDBOX_DIR=
AIRLOCK_SANDBOX_TTL_HOURS=
AIRLOCK_SANDBOX_MAX=
AIRLOCK_SANDBOX_PER_IP_HOUR=
# Behind a reverse proxy every visitor arrives from the proxy's address, which would make
# the per-address limit one global limit. Set to 1 to read the first X-Forwarded-For entry
# instead — ONLY when a proxy you run sets that header, because anyone can send one.
AIRLOCK_TRUST_PROXY=

# Which folders a visitor may open as a workspace — and so which folders the tools can
# read. Separated by ';' on Windows and ':' elsewhere. UNSET on a desk, where any folder
# is fine because it is your machine. On a hosted instance it is the only thing standing
# between a stranger and the server's filesystem: without it, a workspace could be /,
# and every .json, .yml and .log on the box would be readable. So if AIRLOCK_TOKEN or
# AIRLOCK_DEMO is set and this is not, workspaces are switched OFF rather than left open.
AIRLOCK_WORKSPACE_ROOTS=

# Shows a permanent, non-dismissible banner saying this instance is shared and
# anything typed here is visible to other visitors. Set it on any instance more
# than one person can reach.
AIRLOCK_DEMO=
